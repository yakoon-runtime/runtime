{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.autoSearchPaths": true,
  "python.analysis.useLibraryCodeForTypes": true,
  "python.analysis.extraPaths": [
    // packages
    "packages/y5n-runtime-api/src",
    "packages/y5n-runtime-engine/src",
    "packages/y5n-runtime-boot/src",
    "packages/y5n-runtime-store/src",
    "packages/y5n-runtime-transport/src",
    "packages/y5n-runtime-llm/src",
    // packs
    "packs/y5n-packs-root/src",
  ],
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.pytestArgs": [
    "packages/y5n-runtime-engine/tests",
    "packages/y5n-runtime-store/tests/event",
    "packages/y5n-runtime-store/tests/sequence",
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "editor.formatOnSave": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "ruff.enable": true,
  "ruff.organizeImports": true
}
