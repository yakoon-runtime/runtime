{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.autoSearchPaths": true,
  "python.analysis.useLibraryCodeForTypes": true,
  "python.analysis.extraPaths": [
    // yak
    "apps/y5n-apps-yak/src",
    // runtime
    "runtime/y5n-runtime-api/src",
    "runtime/y5n-runtime-engine/src",
    "runtime/y5n-runtime-boot/src",
    "runtime/y5n-runtime-store/src",
    "runtime/y5n-runtime-transport/src",
    "runtime/y5n-runtime-llm/src",
    "sdk/y5n-sdk-python/src",
    // apps
    "apps/y5n-apps-console/src",
    "apps/y5n-apps-runtime/src",
    "apps/y5n-apps-shell/src",
    "apps/y5n-apps-web/src",
    // packs
    "packs/y5n-packs-root/src",
    "packs/y5n-packs-system/src",
    "packs/y5n-packs-ident/src",
    "packs/y5n-packs-crm/src",
    "packs/y5n-packs-luma/src",
  ],
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.pytestArgs": [
    "runtime/y5n-runtime-engine/tests",
    "runtime/y5n-runtime-store/tests/event",
    "runtime/y5n-runtime-store/tests/sequence",
    "packs/y5n-packs-luma/tests",
    "apps/y5n-apps-yak/tests",
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "editor.formatOnSave": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "ruff.enable": true,
  "ruff.organizeImports": true
}