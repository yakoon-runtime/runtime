{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Yakoon: App Console",
            "type": "debugpy",
            "request": "launch",
            "module": "y5n.apps.console",
            "console": "integratedTerminal",
            "env": {
                "DEV_MODE": "true"
            },
        },
        {
            "name": "Yakoon: App Web",
            "type": "debugpy",
            "request": "launch",
            "module": "y5n.apps.web",
            "console": "integratedTerminal",
            "env": {
                "DEV_MODE": "true"
            },
        },
        {
            "name": "Yakoon: App Shell",
            "type": "debugpy",
            "request": "launch",
            "module": "y5n.apps.shell",
            "console": "integratedTerminal",
            "env": {
                "DEV_MODE": "true"
            },
        },
        {
            "name": "Yakoon: Runtime",
            "type": "debugpy",
            "request": "launch",
            "module": "y5n.apps.runtime",
            "args": [
                "9100"
            ],
            "console": "integratedTerminal",
            "env": {
                "DEV_MODE": "true"
            },
        },
    ]
}