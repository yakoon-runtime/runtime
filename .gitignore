# Build artifacts
*.egg-info/

**/__pycache__/
*.pyc
dist/
build/
.venv/
db/*

logs/
**/logs/

# ignore the symlink
yakoon/loop/runtime

# .NET build artifacts
#**/bin/
**/obj/
!/structure/usr/bin/

# Coverage
.coverage
coverage/

# Built workspace trees (workspace.yml is versioned)
/workspace/*/
!/workspace/*/workspace.yml

# Local evolution log
evolution.log.yak/
evolution.log

# Yakoon component metadata is versioned; environment state is not.
.yak/*
!.yak/component.yml
!.yak/mount.yml
!**/structure/**/.yak/
!.yak/
